#!/bin/sh


[ -n "$VERBOSE" ] && echo "prerm called with arguments ${1}, ${2}" >&2
[ -n "$VERBOSE" ] && set -x

remove_property() {
    property_name=$1
    sed -i '/<property>/{:a;N;/<\/property>/!ba; /<name>'${property_name}'<\/name>/d}' ${HBASE_SITE}
}

remove_comment(){
    line_name=$1
    sed  -i  "/<!--${line_name}-->/d" ${HBASE_SITE}
}

stop_service() {
    DAEMON_CONF="__PREFIX__/conf/daemon.conf"
    MAPR_USER=${MAPR_USER:-$([ -f "$DAEMON_CONF" ] && grep "mapr.daemon.user" "$DAEMON_CONF" | cut -d '=' -f 2)}
    MAPR_USER=${MAPR_USER:-"mapr"}
    HBASE_HOME="__PREFIX__/hbase/hbase-__VERSION_3DIGIT__"

    if sudo -u $MAPR_USER -E "${HBASE_HOME}/bin/hbase-daemon.sh" status rest &>/dev/null ; then
        RESULT=$(sudo -u $MAPR_USER -E "${HBASE_HOME}/bin/hbase-daemon.sh" stop rest 2>&1)
        STATUS=$?
        if [ $STATUS -ne 0 ] ; then
            echo "$RESULT"
        fi
    fi
}

case "$1" in
    upgrade)
        stop_service
    ;;

    remove|deconfigure)
        HBASE_SITE=__PREFIX__/hbase/hbase-__VERSION_3DIGIT__/conf/hbase-site.xml
        # Remove secure REST properties from hbase-site.xml
        remove_comment "Enabling Hbase REST encryption"
        remove_property hbase.rest.ssl.enabled
        remove_comment "Enabling Hbase REST impersonation"
        remove_property hbase.rest.support.proxyuser
        remove_comment "Enabling Hbase REST authentication"
        remove_property hbase.rest.authentication.type
        stop_service
    ;;

    failed-upgrade)
    ;;

    *)
        echo "prerm called with unknown argument ${1}" >&2
        exit 1
    ;;
esac
