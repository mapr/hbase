#!/bin/sh

[ -n "$VERBOSE" ] && echo "prerm called with arguments ${1}, ${2}" >&2
[ -n "$VERBOSE" ] && set -x

stop_service() {
    DAEMON_CONF="__PREFIX__/conf/daemon.conf"
    MAPR_USER=${MAPR_USER:-$([ -f "$DAEMON_CONF" ] && grep "mapr.daemon.user" "$DAEMON_CONF" | cut -d '=' -f 2)}
    MAPR_USER=${MAPR_USER:-"mapr"}
    HBASE_HOME="__PREFIX__/hbase/hbase-__VERSION_3DIGIT__"

    if sudo -u $MAPR_USER -E "${HBASE_HOME}/bin/hbase-daemon.sh" status regionserver &>/dev/null ; then
        RESULT=$(sudo -u $MAPR_USER -E "${HBASE_HOME}/bin/hbase-daemon.sh" stop regionserver 2>&1)
        STATUS=$?
        if [ $STATUS -ne 0 ] ; then
            echo "$RESULT"
        fi
    fi
}

case "$1" in
    upgrade)
        stop_service
    ;;

    remove|deconfigure)
        stop_service
    ;;

    failed-upgrade)
    ;;

    *)
        echo "prerm called with unknown argument ${1}" >&2
        exit 1
    ;;
esac
